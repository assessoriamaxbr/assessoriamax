const CRM_COLS = [
  {id:'lead',    label:'Lead',              color:'#3498db'},
  {id:'reuniao', label:'Reunião Agendada',  color:'#9b59b6'},
  {id:'negociacao',label:'Negociação',      color:'#e67e22'},
  {id:'fechado', label:'Venda Fechada',     color:'#d4a843'},
  {id:'noshow',  label:'No-Show',           color:'#e74c3c'},
];

let dragCard = null;
let dragFromCol = null;

function renderCRM(){
  const board = document.getElementById('crmBoard');
  board.innerHTML='';
  CRM_COLS.forEach(col=>{
    const leads = state.leads.filter(l=>l.etapa===col.id);
    const colEl = document.createElement('div');
    colEl.className='crm-col';
    colEl.innerHTML=`
      <div class="crm-col-header" style="border-top:2px solid ${col.color}">
        <div class="crm-col-title" style="color:${col.color}">${col.label}</div>
        <div class="crm-col-count">${leads.length}</div>
      </div>
      <div class="crm-cards" id="col-${col.id}" data-col="${col.id}"></div>`;
    board.appendChild(colEl);

    const cardsEl = colEl.querySelector('.crm-cards');
    setupDropZone(cardsEl, col.id);

    leads.forEach(lead=>{
      cardsEl.appendChild(makeCard(lead));
    });

    // Botão adicionar
    const add = document.createElement('div');
    add.className='add-lead-btn';
    add.textContent='+ Adicionar';
    add.onclick=()=>{ document.getElementById('mEtapa').value=col.id; openModal(); };
    cardsEl.appendChild(add);
  });

  updateCrmBadge();
}

function makeCard(lead){
  const tagClass = `tag-${lead.etapa}`;
  const tagLabel = CRM_COLS.find(c=>c.id===lead.etapa)?.label || lead.etapa;
  const showVal = ['negociacao','fechado'].includes(lead.etapa);

  const el = document.createElement('div');
  el.className='crm-card';
  el.setAttribute('draggable','true');
  el.setAttribute('data-id', lead.id);
  el.innerHTML=`
    <div class="crm-card-name">${lead.nome}</div>
    <div class="crm-card-empresa">${lead.empresa}</div>
    ${showVal?`<input class="val-input" placeholder="R$ Valor da venda" value="${lead.valor||''}" onchange="updateLeadValor('${lead.id}',this.value)" onclick="event.stopPropagation()"/>`:''}
    <div class="crm-card-meta">
      <div class="crm-card-time">${lead.data||''}</div>
      <div class="crm-card-val">${lead.valor?lead.valor:''}</div>
    </div>`;

  el.addEventListener('dragstart',()=>{ dragCard=lead.id; el.classList.add('dragging'); });
  el.addEventListener('dragend',()=>{ el.classList.remove('dragging'); dragCard=null; });
  return el;
}

function setupDropZone(el, colId){
  el.addEventListener('dragover',e=>{e.preventDefault();el.classList.add('drag-over');});
  el.addEventListener('dragleave',()=>el.classList.remove('drag-over'));
  el.addEventListener('drop',e=>{
    e.preventDefault();
    el.classList.remove('drag-over');
    if(!dragCard) return;
    const lead = state.leads.find(l=>l.id===dragCard);
    if(!lead || lead.etapa===colId) return;
    const oldEtapa = lead.etapa;
    lead.etapa = colId;

    // Se moveu para FECHADO: dispara Purchase
    if(colId==='fechado'){
      firePixelPurchase(lead);
    }

    saveState();
    renderCRM();
    renderDash();
  });
}

function updateLeadValor(id, val){
  const lead = state.leads.find(l=>l.id===id);
  if(lead){ lead.valor=val; saveState(); }
}

function updateCrmBadge(){
  document.getElementById('crmBadge').textContent = state.leads.length;
}

// ══════════════════════════════════════
//  MODAL
// ══════════════════════════════════════
function openModal(){ document.getElementById('modalOverlay').classList.add('open'); }
function closeModal(){ document.getElementById('modalOverlay').classList.remove('open'); }

function addLeadFromModal(){
  const nome = document.getElementById('mNome').value.trim();
  if(!nome){ alert('Informe o nome do lead'); return; }
  const lead = {
    id: 'lead_'+Date.now(),
    nome,
    empresa: document.getElementById('mEmpresa').value.trim(),
    whatsapp: document.getElementById('mWhats').value.trim(),
    etapa: document.getElementById('mEtapa').value,
    valor: document.getElementById('mValor').value.trim(),
    data: new Date().toLocaleDateString('pt-BR'),
  };
  state.leads.unshift(lead);
  saveState();
  closeModal();
  renderCRM();
  renderDash();
  ['mNome','mEmpresa','mWhats','mValor'].forEach(id=>document.getElementById(id).value='');
}

// ══════════════════════════════════════
//  PIXEL FACEBOOK
// ══════════════════════════════════════
function savePixelConfig(){
  const id = document.getElementById('pixelId').value.trim();
  const token = document.getElementById('pixelToken').value.trim();
  if(!id){ alert('Informe o ID do Pixel'); return; }
  state.pixelId = id;
  state.pixelToken = token;
  saveState();
  updatePixelStatus();
  updatePixelPreview();
  injectPixelInFunil(id);
  alert('✅ Pixel salvo! Código configurado. Agora suba novamente o assessoriamax.html na Vercel.');
}

function updatePixelStatus(){
  const ok = !!state.pixelId;
  const badge = document.getElementById('pixelStatusBadge');
  const sidebar = document.getElementById('pixelStatusSidebar');
  if(ok){
    badge.className='settings-status ok';
    badge.textContent='● Ativo — ID: '+state.pixelId;
    sidebar.style.color='var(--green)';
    sidebar.textContent='Ativo';
  } else {
    badge.className='settings-status off';
    badge.textContent='● Não configurado';
    sidebar.style.color='var(--red)';
    sidebar.textContent='Não configurado';
  }
}

function updatePixelPreview(){
  const id = document.getElementById('pixelId').value.trim() || 'SEU_PIXEL_ID';
  document.getElementById('pixelPreview').innerHTML =
`<span class="hl">/* Código gerado automaticamente para assessoriamax.html */</span>

<span class="hl">/* 1. PageView — dispara ao abrir a página */</span>
!function(f,b,e,v,n,t,s){...}(window,document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '<span class="hl">${id}</span>');
fbq('track', 'PageView');

<span class="hl">/* 2. Lead — dispara ao finalizar o diagnóstico */</span>
fbq('track', 'Lead');

<span class="hl">/* 3. Purchase — dispara via CRM ao fechar venda */</span>
fbq('track', 'Purchase', {
  value: <span class="hl">VALOR_DA_VENDA</span>,
  currency: 'BRL'
});`;
}

function injectPixelInFunil(pixelId){
  // Gera o snippet que deve ser colado no assessoriamax.html
  const snippet = `<!-- Facebook Pixel -->
<script>
!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
document,'script','https://connect.facebook.net/en_US/fbevents.js');
fbq('init','${pixelId}');
fbq('track','PageView');
<\/script>
<noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1"/></noscript>
<!-- Fim do Pixel -->`;
  console.log('PIXEL SNIPPET (cole no <head> do assessoriamax.html):\n', snippet);
}

function firePixelPurchase(lead){
  if(!document.getElementById('togglePurchase').checked) return;
  if(!state.pixelId){ console.warn('Pixel não configurado'); return; }
  const valor = parseFloat((lead.valor||'0').replace(/[^0-9.]/g,''))||0;
  if(typeof fbq !== 'undefined'){
    fbq('track','Purchase',{value:valor,currency:'BRL'});
  }
  console.log('🟡 Purchase disparado - Valor: R$'+valor+' - Lead: '+lead.nome);
}

