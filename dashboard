function saveFbAds(){
  const token = document.getElementById('fbAdsToken').value.trim();
  const account = document.getElementById('fbAdAccountId').value.trim();
  if(!token||!account){ alert('Preencha o token e o ID da conta'); return; }
  state.fbAdsToken = token;
  state.fbAdAccountId = account;
  saveState();
  document.getElementById('fbAdsStatus').className='settings-status ok';
  document.getElementById('fbAdsStatus').textContent='● Conectado';
  alert('✅ Facebook Ads conectado! Os dados de custo aparecerão no Dashboard.');
}

