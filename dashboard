<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>AssessoriaMax · Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#080808;--sidebar:#0e0e0e;--card:#111;--card2:#161616;--border:#222;--border2:#2a2a2a;
  --gold:#d4a843;--gold2:#f0c85a;--gold3:#a07828;--gold-dim:rgba(212,168,67,0.1);--gold-border:rgba(212,168,67,0.25);
  --text:#f0f0f0;--muted:#666;--muted2:#444;
  --green:#2ecc71;--red:#e74c3c;--blue:#3498db;--purple:#9b59b6;--orange:#e67e22;
  --sidebar-w:220px;
}
html,body{background:var(--bg);color:var(--text);font-family:'Barlow',sans-serif;height:100%;overflow-x:hidden}

/* ── LAYOUT ── */
.layout{display:flex;min-height:100vh}

/* ── SIDEBAR ── */
.sidebar{
  width:var(--sidebar-w);flex-shrink:0;background:var(--sidebar);
  border-right:1px solid var(--border);display:flex;flex-direction:column;
  position:fixed;top:0;left:0;height:100vh;z-index:100;
}
.sidebar-logo{padding:24px 20px 20px;border-bottom:1px solid var(--border)}
.logo-mark{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:var(--gold)}
.logo-sub{font-size:10px;color:var(--muted);letter-spacing:1.5px;text-transform:uppercase;margin-top:2px}
.sidebar-nav{flex:1;padding:16px 0;overflow-y:auto}
.nav-section{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--muted2);padding:12px 20px 6px}
.nav-item{
  display:flex;align-items:center;gap:10px;padding:10px 20px;cursor:pointer;
  font-size:13px;color:var(--muted);transition:all .15s;border-left:2px solid transparent;
}
.nav-item:hover{color:var(--text);background:rgba(255,255,255,.03)}
.nav-item.active{color:var(--gold);border-left-color:var(--gold);background:var(--gold-dim)}
.nav-item svg{width:16px;height:16px;flex-shrink:0}
.nav-badge{margin-left:auto;background:var(--gold);color:#000;font-size:10px;font-weight:700;padding:2px 7px;border-radius:100px}

.sidebar-footer{padding:16px 20px;border-top:1px solid var(--border)}
.sidebar-footer p{font-size:11px;color:var(--muted);line-height:1.5}
.sidebar-footer strong{color:var(--gold)}

/* ── MAIN ── */
.main{margin-left:var(--sidebar-w);flex:1;display:flex;flex-direction:column;min-height:100vh}

/* ── TOPBAR ── */
.topbar{
  position:sticky;top:0;z-index:50;background:rgba(8,8,8,.95);
  backdrop-filter:blur(12px);border-bottom:1px solid var(--border);
  padding:14px 28px;display:flex;align-items:center;justify-content:space-between;
}
.topbar-title{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:2px;color:var(--text)}
.topbar-right{display:flex;align-items:center;gap:12px}
.period-select{
  background:var(--card2);border:1px solid var(--border2);border-radius:8px;
  padding:7px 12px;font-size:12px;color:var(--text);font-family:'Barlow',sans-serif;outline:none;cursor:pointer;
}
.topbar-sync{
  background:var(--gold-dim);border:1px solid var(--gold-border);border-radius:8px;
  padding:7px 14px;font-size:12px;color:var(--gold);font-weight:600;cursor:pointer;
  display:flex;align-items:center;gap:6px;transition:all .15s;
}
.topbar-sync:hover{background:rgba(212,168,67,.2)}

/* ── PAGE ── */
.page{display:none;padding:24px 28px;flex:1}
.page.active{display:block}

/* ── SECTION HEADER ── */
.section-hdr{margin-bottom:20px}
.section-hdr h2{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:2px;color:var(--text);line-height:1}
.section-hdr p{font-size:13px;color:var(--muted);margin-top:4px}

/* ── KPI GRID ── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:24px}
.kpi-card{
  background:var(--card);border:1px solid var(--border);border-radius:12px;
  padding:18px;position:relative;overflow:hidden;
}
.kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--gold)}
.kpi-label{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.kpi-value{font-family:'Bebas Neue',sans-serif;font-size:36px;letter-spacing:1px;color:var(--gold);line-height:1}
.kpi-sub{font-size:12px;color:var(--muted);margin-top:6px}
.kpi-change{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:3px 8px;border-radius:100px;margin-top:8px}
.kpi-change.up{background:rgba(46,204,113,.12);color:var(--green)}
.kpi-change.down{background:rgba(231,76,60,.12);color:var(--red)}
.kpi-change.neutral{background:rgba(255,255,255,.06);color:var(--muted)}

/* ── CHARTS ROW ── */
.charts-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:24px}
.chart-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px}
.chart-card.full{grid-column:1/-1}
.chart-title{font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:16px;display:flex;align-items:center;justify-content:space-between}
.chart-title span{color:var(--gold);font-size:11px;font-weight:600;letter-spacing:0}

/* FUNNEL VISUAL */
.funnel-wrap{display:flex;flex-direction:column;gap:6px}
.funnel-step{display:flex;align-items:center;gap:12px}
.funnel-bar-wrap{flex:1;background:var(--border);border-radius:4px;height:32px;overflow:hidden;position:relative}
.funnel-bar{height:100%;background:linear-gradient(90deg,var(--gold3),var(--gold));border-radius:4px;transition:width .6s ease;display:flex;align-items:center;padding-left:10px}
.funnel-bar span{font-size:12px;font-weight:700;color:#000;white-space:nowrap}
.funnel-label{font-size:12px;color:var(--muted);width:130px;text-align:right;flex-shrink:0}
.funnel-pct{font-size:11px;color:var(--gold);width:40px;text-align:right;flex-shrink:0;font-weight:600}
.funnel-drop{font-size:10px;color:var(--red);width:50px;text-align:right;flex-shrink:0}

/* BAR CHART */
.bar-chart{display:flex;align-items:flex-end;gap:8px;height:120px;padding-top:8px}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px}
.bar-fill{width:100%;background:linear-gradient(180deg,var(--gold2),var(--gold3));border-radius:4px 4px 0 0;transition:height .5s ease;min-height:4px}
.bar-fill.blue{background:linear-gradient(180deg,#5dade2,#1a6fa8)}
.bar-label{font-size:10px;color:var(--muted);text-align:center}
.bar-val{font-size:11px;color:var(--gold);font-weight:600}

/* DONUT */
.donut-wrap{display:flex;align-items:center;gap:20px}
.donut-svg{flex-shrink:0}
.donut-legend{flex:1;display:flex;flex-direction:column;gap:8px}
.legend-item{display:flex;align-items:center;gap:8px;font-size:12px}
.legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.legend-val{margin-left:auto;font-weight:700;color:var(--text)}

/* ── CRM ── */
.crm-wrap{display:flex;gap:12px;overflow-x:auto;padding-bottom:12px}
.crm-col{min-width:220px;flex-shrink:0}
.crm-col-header{
  background:var(--card2);border:1px solid var(--border);border-radius:10px 10px 0 0;
  padding:12px 14px;display:flex;align-items:center;justify-content:space-between;
}
.crm-col-title{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase}
.crm-col-count{background:var(--gold-dim);border:1px solid var(--gold-border);color:var(--gold);font-size:10px;font-weight:700;padding:2px 8px;border-radius:100px}
.crm-cards{
  background:rgba(255,255,255,.02);border:1px solid var(--border);border-top:none;
  border-radius:0 0 10px 10px;padding:10px;display:flex;flex-direction:column;gap:8px;
  min-height:200px;
}
.crm-card{
  background:var(--card);border:1px solid var(--border2);border-radius:8px;padding:12px;
  cursor:grab;transition:border .15s,box-shadow .15s;
}
.crm-card:hover{border-color:var(--gold-border);box-shadow:0 4px 20px rgba(212,168,67,.08)}
.crm-card.dragging{opacity:.5;cursor:grabbing}
.crm-card-name{font-size:13px;font-weight:600;color:var(--text);margin-bottom:4px}
.crm-card-empresa{font-size:11px;color:var(--muted)}
.crm-card-meta{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
.crm-card-time{font-size:10px;color:var(--muted2)}
.crm-card-val{font-size:12px;font-weight:700;color:var(--gold)}
.crm-card-tag{font-size:10px;padding:2px 8px;border-radius:100px;font-weight:600}
.tag-lead{background:rgba(52,152,219,.15);color:#5dade2;border:1px solid rgba(52,152,219,.3)}
.tag-reuniao{background:rgba(155,89,182,.15);color:#bb8fce;border:1px solid rgba(155,89,182,.3)}
.tag-negociacao{background:rgba(230,126,34,.15);color:#f0a060;border:1px solid rgba(230,126,34,.3)}
.tag-fechado{background:rgba(46,204,113,.15);color:#58d68d;border:1px solid rgba(46,204,113,.3)}
.tag-noshow{background:rgba(231,76,60,.15);color:#f1948a;border:1px solid rgba(231,76,60,.3)}

/* VALOR INPUT no card */
.val-input{
  width:100%;background:var(--card2);border:1px solid var(--border2);border-radius:6px;
  padding:5px 8px;font-size:12px;color:var(--gold);font-family:'Barlow',sans-serif;
  outline:none;margin-top:6px;
}
.val-input:focus{border-color:var(--gold-border)}
.val-input::placeholder{color:var(--muted2)}

/* ADD LEAD BTN */
.add-lead-btn{
  background:var(--gold-dim);border:1px dashed var(--gold-border);border-radius:8px;
  padding:10px;text-align:center;font-size:12px;color:var(--gold);cursor:pointer;
  transition:all .15s;
}
.add-lead-btn:hover{background:rgba(212,168,67,.2)}

/* ── MODAL ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:999;display:none;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.modal-overlay.open{display:flex}
.modal{background:var(--card);border:1px solid var(--border2);border-radius:16px;padding:28px;width:90%;max-width:440px;position:relative}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:var(--gold);margin-bottom:20px}
.modal-close{position:absolute;top:16px;right:16px;background:none;border:none;color:var(--muted);font-size:20px;cursor:pointer}
.form-group{margin-bottom:14px}
.form-label{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:6px;display:block}
.form-input,.form-select{
  width:100%;background:var(--card2);border:1.5px solid var(--border2);border-radius:8px;
  padding:11px 14px;font-size:13px;color:var(--text);font-family:'Barlow',sans-serif;outline:none;transition:border .2s;
}
.form-input:focus,.form-select:focus{border-color:var(--gold)}
.form-select option{background:var(--card2)}
.modal-btn{
  width:100%;padding:13px;background:var(--gold);border:none;border-radius:10px;
  font-size:14px;font-weight:700;color:#000;font-family:'Barlow',sans-serif;cursor:pointer;margin-top:6px;
}

/* ── SETTINGS ── */
.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.settings-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:22px}
.settings-card.full{grid-column:1/-1}
.settings-card-title{font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:4px;display:flex;align-items:center;gap:8px}
.settings-card-desc{font-size:12px;color:var(--muted);margin-bottom:18px;line-height:1.5}
.settings-status{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:3px 10px;border-radius:100px;margin-bottom:14px}
.settings-status.ok{background:rgba(46,204,113,.12);color:var(--green)}
.settings-status.off{background:rgba(231,76,60,.12);color:var(--red)}
.settings-status.pending{background:rgba(230,126,34,.12);color:var(--orange)}
.settings-save{
  margin-top:12px;padding:10px 20px;background:var(--gold);border:none;border-radius:8px;
  font-size:12px;font-weight:700;color:#000;font-family:'Barlow',sans-serif;cursor:pointer;transition:opacity .15s;
}
.settings-save:hover{opacity:.85}
.settings-save.outline{background:transparent;border:1px solid var(--gold-border);color:var(--gold)}
.settings-hint{font-size:11px;color:var(--muted);margin-top:8px;line-height:1.5}
.settings-hint a{color:var(--gold);text-decoration:none}
.pixel-preview{
  background:var(--card2);border:1px solid var(--border2);border-radius:8px;padding:14px;
  font-size:11px;font-family:monospace;color:#aaa;line-height:1.7;margin-top:12px;white-space:pre-wrap;word-break:break-all;
}
.pixel-preview .hl{color:var(--gold)}
.events-list{display:flex;flex-direction:column;gap:8px;margin-top:4px}
.event-item{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:var(--card2);border:1px solid var(--border2);border-radius:8px}
.event-name{font-size:12px;font-weight:600;color:var(--text)}
.event-trigger{font-size:11px;color:var(--muted)}
.event-badge{font-size:10px;padding:2px 8px;border-radius:100px;font-weight:600;background:rgba(46,204,113,.12);color:var(--green);border:1px solid rgba(46,204,113,.25)}
.toggle-wrap{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)}
.toggle-wrap:last-child{border-bottom:none}
.toggle-label{font-size:13px;color:var(--text)}
.toggle-sub{font-size:11px;color:var(--muted);margin-top:2px}
.toggle{position:relative;width:40px;height:22px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.toggle-slider{position:absolute;inset:0;background:var(--border2);border-radius:100px;cursor:pointer;transition:.2s}
.toggle-slider::before{content:'';position:absolute;width:16px;height:16px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.2s}
.toggle input:checked+.toggle-slider{background:var(--gold)}
.toggle input:checked+.toggle-slider::before{transform:translateX(18px)}

/* ── EMPTY STATE ── */
.empty-state{text-align:center;padding:40px 20px;color:var(--muted)}
.empty-state svg{width:40px;height:40px;margin:0 auto 12px;opacity:.3}
.empty-state p{font-size:13px}

/* ── SCROLL ── */
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}

/* ── DRAG OVER ── */
.crm-cards.drag-over{background:var(--gold-dim);border-color:var(--gold-border)}

@media(max-width:768px){
  .sidebar{transform:translateX(-100%);transition:transform .3s}
  .sidebar.open{transform:none}
  .main{margin-left:0}
  .charts-row{grid-template-columns:1fr}
  .settings-grid{grid-template-columns:1fr}
  .kpi-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>

<div class="layout">

<!-- ══════════════════════════════════════
     SIDEBAR
══════════════════════════════════════ -->
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-mark">AssessoriaMax</div>
    <div class="logo-sub">Dashboard Comercial</div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Principal</div>
    <div class="nav-item active" onclick="showPage('dash',this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      Dashboard
    </div>
    <div class="nav-item" onclick="showPage('funil',this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
      Funil
    </div>
    <div class="nav-section">Comercial</div>
    <div class="nav-item" onclick="showPage('crm',this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      CRM
      <span class="nav-badge" id="crmBadge">0</span>
    </div>
    <div class="nav-section">Sistema</div>
    <div class="nav-item" onclick="showPage('settings',this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
      Configurações
    </div>
  </nav>
  <div class="sidebar-footer">
    <p>Pixel: <strong id="pixelStatusSidebar">Não configurado</strong><br>
    Sheets: <strong style="color:var(--green)">Conectado</strong></p>
  </div>
</aside>

<!-- ══════════════════════════════════════
     MAIN
══════════════════════════════════════ -->
<main class="main">
  <div class="topbar">
    <div class="topbar-title" id="pageTitle">Dashboard</div>
    <div class="topbar-right">
      <select class="period-select" id="periodSelect" onchange="updateAll()">
        <option value="7">Últimos 7 dias</option>
        <option value="30" selected>Últimos 30 dias</option>
        <option value="90">Últimos 90 dias</option>
      </select>
      <div class="topbar-sync" onclick="syncSheets()">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        Sincronizar
      </div>
    </div>
  </div>

  <!-- ═══ DASHBOARD ═══ -->
  <div class="page active" id="page-dash">
    <div class="section-hdr">
      <h2>Visão Geral</h2>
      <p>Métricas e performance do seu funil comercial</p>
    </div>

    <!-- KPIs -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-label">Total de Leads</div>
        <div class="kpi-value" id="kpiLeads">—</div>
        <div class="kpi-change up" id="kpiLeadsChange">↑ 0%</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Taxa de Conclusão</div>
        <div class="kpi-value" id="kpiConclusao">—</div>
        <div class="kpi-change" id="kpiConclusaoChange">↑ 0%</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Reuniões Agendadas</div>
        <div class="kpi-value" id="kpiReunioes">—</div>
        <div class="kpi-change up" id="kpiReunioesChange">↑ 0%</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Vendas Fechadas</div>
        <div class="kpi-value" id="kpiVendas">—</div>
        <div class="kpi-change up" id="kpiVendasChange">↑ 0%</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Receita Fechada</div>
        <div class="kpi-value" id="kpiReceita">—</div>
        <div class="kpi-change up" id="kpiReceitaChange">↑ 0%</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Em Negociação</div>
        <div class="kpi-value" id="kpiNegociacao">—</div>
        <div class="kpi-sub" id="kpiNegociacaoVal" style="color:var(--gold)">R$ 0</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Custo por Lead (CAC)</div>
        <div class="kpi-value" id="kpiCAC">—</div>
        <div class="kpi-change" id="kpiCACChange">0%</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Custo por Reunião</div>
        <div class="kpi-value" id="kpiCPR">—</div>
        <div class="kpi-change" id="kpiCPRChange">0%</div>
      </div>
    </div>

    <!-- Charts -->
    <div class="charts-row">
      <div class="chart-card">
        <div class="chart-title">Leads por Dia <span id="chartLeadsSpan"></span></div>
        <div class="bar-chart" id="barChartLeads"></div>
        <div style="display:flex;gap:8px;margin-top:8px" id="barChartLabels"></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Distribuição CRM</div>
        <div class="donut-wrap">
          <svg class="donut-svg" width="110" height="110" viewBox="0 0 110 110" id="donutSvg">
