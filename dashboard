<script>
// ══════════════════════════════════════
//  ESTADO GLOBAL
// ══════════════════════════════════════
const SHEET_URL = "https://script.google.com/macros/s/AKfycbzL8pmlfZpQy_pbPJm0h_IHxL9xTePtQNw-j8ETwv4OKgSISLtwt1WgDWEpKMhhoO3GfQ/exec";

let state = loadState();

function loadState(){
  try{
    const s = localStorage.getItem('am_dashboard');
    if(s) return JSON.parse(s);
  }catch(e){}
  return {
    leads: generateSampleLeads(),
    pixelId: '',
    pixelToken: '',
    fbAdsToken: '',
    fbAdAccountId: '',
    settings: { purchase: true, lead: true }
  };
}

function saveState(){
  localStorage.setItem('am_dashboard', JSON.stringify(state));
}

function generateSampleLeads(){
  const nomes = ['Dr. Carlos Menezes','Dra. Ana Lima','Dr. Roberto Silva','Dra. Fernanda Costa','Dr. Paulo Ribeiro','Dra. Juliana Neves'];
  const empresas = ['Escritório Menezes','Lima Advocacia','Silva & Assoc.','Costa Prev.','Ribeiro Advogados','Neves Jurídico'];
  const etapas = ['lead','lead','reuniao','negociacao','fechado','noshow'];
  const valores = ['','','','4500','6800',''];
  return nomes.map((n,i)=>({
    id:'lead_sample_'+i,
    nome:n,
    empresa:empresas[i],
    whatsapp:'(89) 9'+Math.floor(Math.random()*9000+1000)+'-'+Math.floor(Math.random()*9000+1000),
    etapa:etapas[i],
    valor:valores[i],
    data: new Date(Date.now() - Math.random()*2592000000).toLocaleDateString('pt-BR')
  }));
}

// ══════════════════════════════════════
//  NAVEGAÇÃO
// ══════════════════════════════════════
const pageTitles = {dash:'Dashboard',funil:'Análise do Funil',crm:'CRM de Leads',settings:'Configurações'};

function showPage(id, el){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  if(el) el.classList.add('active');
  document.getElementById('pageTitle').textContent = pageTitles[id];
  if(id==='dash') renderDash();
  if(id==='funil') renderFunil();
  if(id==='crm') renderCRM();
}

// ══════════════════════════════════════
//  MÉTRICAS CALCULADAS
// ══════════════════════════════════════
function getMetrics(){
  const leads = state.leads;
  const total = leads.length;
  const concluidos = leads.filter(l=>l.etapa !== 'lead' || l.gargalo).length;
  const reunioes = leads.filter(l=>['reuniao','negociacao','fechado'].includes(l.etapa)).length;
  const fechados = leads.filter(l=>l.etapa==='fechado').length;
  const noshow = leads.filter(l=>l.etapa==='noshow').length;
  const negociacao = leads.filter(l=>l.etapa==='negociacao').length;
  const receitaFechada = leads.filter(l=>l.etapa==='fechado').reduce((s,l)=>s+parseFloat((l.valor||'0').replace(/[^0-9.]/g,'')||0),0);
  const valorNegociacao = leads.filter(l=>l.etapa==='negociacao').reduce((s,l)=>s+parseFloat((l.valor||'0').replace(/[^0-9.]/g,'')||0),0);
  const taxaConclusao = total>0?Math.round((concluidos/total)*100):0;
  const taxaVenda = reunioes>0?Math.round((fechados/reunioes)*100):0;
  return {total,concluidos,reunioes,fechados,noshow,negociacao,receitaFechada,valorNegociacao,taxaConclusao,taxaVenda};
}

function fmtBRL(v){
  return 'R$ '+v.toLocaleString('pt-BR',{minimumFractionDigits:0,maximumFractionDigits:0});
}

function changeBadge(el, pct, goodIsUp=true){
  const up = pct >= 0;
  const cls = up === goodIsUp ? 'up' : 'down';
  el.className = 'kpi-change ' + cls;
  el.textContent = (up?'↑':'↓')+' '+Math.abs(pct)+'%';
}

// ══════════════════════════════════════
//  DASHBOARD
// ══════════════════════════════════════
function renderDash(){
  const m = getMetrics();

  document.getElementById('kpiLeads').textContent = m.total;
  document.getElementById('kpiConclusao').textContent = m.taxaConclusao+'%';
  document.getElementById('kpiReunioes').textContent = m.reunioes;
  document.getElementById('kpiVendas').textContent = m.fechados;
  document.getElementById('kpiReceita').textContent = fmtBRL(m.receitaFechada);
  document.getElementById('kpiNegociacao').textContent = m.negociacao;
  document.getElementById('kpiNegociacaoVal').textContent = fmtBRL(m.valorNegociacao)+' em aberto';
  document.getElementById('kpiCAC').textContent = m.total>0?'—':'—';
  document.getElementById('kpiCPR').textContent = m.reunioes>0?'—':'—';

  // Mudanças (simuladas para demonstração)
  changeBadge(document.getElementById('kpiLeadsChange'), 12);
  changeBadge(document.getElementById('kpiConclusaoChange'), m.taxaConclusao>50?8:-5);
  changeBadge(document.getElementById('kpiReunioesChange'), 20);
  changeBadge(document.getElementById('kpiVendasChange'), 15);
  changeBadge(document.getElementById('kpiReceitaChange'), 18);
  changeBadge(document.getElementById('kpiCACChange'), -8, false);
  changeBadge(document.getElementById('kpiCPRChange'), -12, false);

  renderBarChart();
  renderDonut(m);
  renderEtapaChart(m);
  updateCrmBadge();
}

function renderBarChart(){
  const days = ['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'];
  const vals = days.map(()=>Math.floor(Math.random()*8+1));
  const max = Math.max(...vals);
  const container = document.getElementById('barChartLeads');
  const labels = document.getElementById('barChartLabels');
  container.innerHTML=''; labels.innerHTML='';
  vals.forEach((v,i)=>{
    const col = document.createElement('div');
    col.className='bar-col';
    col.innerHTML=`<div class="bar-val">${v}</div><div class="bar-fill" style="height:${Math.round((v/max)*100)}px"></div>`;
    container.appendChild(col);
    const lbl = document.createElement('div');
    lbl.style.cssText='flex:1;text-align:center;font-size:10px;color:var(--muted)';
    lbl.textContent=days[i];
    labels.appendChild(lbl);
  });
}

function renderDonut(m){
  const svg = document.getElementById('donutSvg');
  const legend = document.getElementById('donutLegend');
  const total = m.total||1;
  const slices = [
    {label:'Leads',val:state.leads.filter(l=>l.etapa==='lead').length,color:'#3498db'},
    {label:'Reunião',val:m.reunioes,color:'#9b59b6'},
    {label:'Negociação',val:m.negociacao,color:'#e67e22'},
    {label:'Fechado',val:m.fechados,color:'#d4a843'},
    {label:'No-Show',val:m.noshow,color:'#e74c3c'},
  ];
  const r=40, cx=55, cy=55, circ=2*Math.PI*r;
  svg.innerHTML='<circle cx="55" cy="55" r="40" fill="none" stroke="#222" stroke-width="20"/>';
  let offset=0;
  slices.forEach(s=>{
    if(!s.val) return;
    const pct=s.val/total;
    const dash=pct*circ;
    const el=document.createElementNS('http://www.w3.org/2000/svg','circle');
    el.setAttribute('cx',cx);el.setAttribute('cy',cy);el.setAttribute('r',r);
    el.setAttribute('fill','none');el.setAttribute('stroke',s.color);el.setAttribute('stroke-width','20');
    el.setAttribute('stroke-dasharray',`${dash} ${circ-dash}`);
    el.setAttribute('stroke-dashoffset',-offset*circ);
    el.setAttribute('transform','rotate(-90 55 55)');
    svg.appendChild(el);
    offset+=pct;
  });
  legend.innerHTML=slices.map(s=>`
    <div class="legend-item">
      <div class="legend-dot" style="background:${s.color}"></div>
      <span style="color:var(--muted);font-size:12px">${s.label}</span>
      <span class="legend-val">${s.val}</span>
    </div>`).join('');
}

function renderEtapaChart(m){
  const etapas = [
    {label:'Iniciou Diagnóstico',val:m.total,pct:100},
    {label:'Informou WhatsApp',val:Math.round(m.total*.85),pct:85},
    {label:'Concluiu Diagnóstico',val:m.concluidos,pct:m.taxaConclusao},
    {label:'Agendou Reunião',val:m.reunioes,pct:m.total>0?Math.round(m.reunioes/m.total*100):0},
    {label:'Venda Fechada',val:m.fechados,pct:m.total>0?Math.round(m.fechados/m.total*100):0},
  ];
  const el = document.getElementById('etapaChart');
  el.innerHTML = etapas.map(e=>`
    <div style="display:flex;align-items:center;gap:12px">
      <div style="width:180px;font-size:12px;color:var(--muted);text-align:right;flex-shrink:0">${e.label}</div>
      <div style="flex:1;background:var(--border);border-radius:4px;height:24px;overflow:hidden">
        <div style="width:${e.pct}%;height:100%;background:linear-gradient(90deg,var(--gold3),var(--gold));border-radius:4px;display:flex;align-items:center;padding-left:8px;transition:width .6s ease">
          <span style="font-size:11px;font-weight:700;color:#000;white-space:nowrap">${e.val}</span>
        </div>
      </div>
      <div style="font-size:11px;color:var(--gold);font-weight:700;width:36px;text-align:right">${e.pct}%</div>
    </div>`).join('');
}

// ══════════════════════════════════════
//  FUNIL
// ══════════════════════════════════════
function renderFunil(){
  const m = getMetrics();
  const total = m.total || 1;

  const steps = [
    {label:'Abriu a Página',n:Math.round(total*1.8)},
    {label:'Digitou o Nome',n:total},
    {label:'Informou WhatsApp',n:Math.round(total*.85)},
    {label:'Preencheu Instagram',n:Math.round(total*.78)},
    {label:'Informou Empresa',n:Math.round(total*.75)},
    {label:'Escolheu Papel',n:Math.round(total*.70)},
    {label:'Respondeu Investimento',n:Math.round(total*.68)},
    {label:'Informou Faturamento',n:Math.round(total*.65)},
    {label:'Informou Gargalo',n:m.concluidos},
    {label:'Clicou no CTA',n:Math.round(m.concluidos*.9)},
  ];

  const max = steps[0].n || 1;
  const viz = document.getElementById('funnelViz');
  viz.innerHTML = steps.map((s,i)=>{
    const pct = Math.round(s.n/max*100);
    const drop = i>0?Math.round((1-s.n/steps[i-1].n)*100):0;
    return `
    <div class="funnel-step">
      <div class="funnel-label">${s.label}</div>
      <div class="funnel-bar-wrap">
        <div class="funnel-bar" style="width:${pct}%">
          <span>${s.n} leads</span>
        </div>
      </div>
      <div class="funnel-pct">${pct}%</div>
      <div class="funnel-drop">${i>0?'-'+drop+'%':''}</div>
    </div>`;
  }).join('');

  // dropoff chart
  const dropContainer = document.getElementById('dropoffChart');
  const dropLabels = document.getElementById('dropoffLabels');
  const drops = steps.slice(1).map((s,i)=>({
    label:s.label.split(' ')[0],
    val:Math.round((1-s.n/steps[i].n)*100)
  }));
  const dmax = Math.max(...drops.map(d=>d.val))||1;
  dropContainer.innerHTML='';
  dropLabels.innerHTML='';
  drops.forEach(d=>{
    const col=document.createElement('div');col.className='bar-col';
    col.innerHTML=`<div class="bar-val" style="color:var(--red);font-size:10px">${d.val}%</div><div class="bar-fill" style="height:${Math.round((d.val/dmax)*90)}px;background:linear-gradient(180deg,#e74c3c,#c0392b)"></div>`;
    dropContainer.appendChild(col);
    const lbl=document.createElement('div');
    lbl.style.cssText='flex:1;text-align:center;font-size:9px;color:var(--muted)';
    lbl.textContent=d.label;
    dropLabels.appendChild(lbl);
  });

  // gargalo chart
  const gargalos = {};
  state.leads.forEach(l=>{ if(l.gargalo){ gargalos[l.gargalo]=(gargalos[l.gargalo]||0)+1; }});
  const sorted = Object.entries(gargalos).sort((a,b)=>b[1]-a[1]);
  const gmax = sorted[0]?sorted[0][1]:1;
  document.getElementById('gargaloChart').innerHTML = sorted.length ? sorted.map(([k,v])=>`
    <div>
      <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
        <span style="color:var(--text)">${k}</span>
        <span style="color:var(--gold);font-weight:700">${v}</span>
      </div>
      <div style="background:var(--border);border-radius:4px;height:6px">
        <div style="width:${Math.round(v/gmax*100)}%;height:100%;background:var(--gold);border-radius:4px"></div>
      </div>
    </div>`).join('') : '<div class="empty-state"><p>Sem dados ainda</p></div>';
}

